# === Servidor ===
PORT=3000
NODE_ENV=development

# === Base de Datos ===
# MariaDB/MySQL connection string
DATABASE_URL=mysql://user:password@host:3306/database
# Require SSL for database connection (default: true, set to false for local dev)
DATABASE_REQUIRE_SSL=false

# === Broker / Logística ===
# URL del servicio Broker (actúa como proxy hacia Logística)
# Local: http://localhost:3002
# Producción: https://broker-services-production.up.railway.app
BROKER_SERVICE_URL=http://localhost:3002
